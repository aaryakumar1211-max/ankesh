{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "prisma:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^prisma:generate"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "^prisma:generate"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
